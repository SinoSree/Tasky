# ---------------------------------------------------------------------------
# Taskly auth server — example environment file.
#
# HOW TO USE THIS FILE
#   1. Copy it:  cp .env.example .env
#   2. Fill in the real values in .env
#   3. Never commit .env — it is already in .gitignore
#
# This file (.env.example) IS committed on purpose. It documents which
# settings exist without revealing any of their values, so anyone cloning
# the project knows what they need to supply.
# ---------------------------------------------------------------------------

# --- Server ----------------------------------------------------------------
PORT=4000
NODE_ENV=development

# Where your React app runs. The browser blocks requests between different
# origins unless the server explicitly allows them (CORS). Comma-separated.
CLIENT_ORIGIN=http://localhost:5173,http://localhost:8077

# --- Database --------------------------------------------------------------
# MongoDB Atlas connection string. Get it from:
#   Atlas dashboard → Connect → Drivers → copy the string
# Replace <password> with your database user's password, and put the database
# name before the "?" — e.g. .../taskly?retryWrites=true
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/taskly?retryWrites=true&w=majority

# --- Authentication --------------------------------------------------------
# Secret used to sign login cookies. Anyone who knows this can forge a login,
# so treat it like a password. Generate a strong one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-me-with-a-long-random-string
JWT_EXPIRES_IN=7d

# --- Email (Gmail app password) --------------------------------------------
# NOT your normal Gmail password. Steps:
#   1. Turn on 2-Step Verification: myaccount.google.com/security
#   2. Go to myaccount.google.com/apppasswords
#   3. Create one named "Taskly" and copy the 16 characters
#   4. Paste it below WITHOUT spaces
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your.address@gmail.com
SMTP_PASS=your16charapppassword
MAIL_FROM_NAME=Taskly
MAIL_FROM_ADDRESS=your.address@gmail.com

# --- OTP behaviour ---------------------------------------------------------
OTP_LENGTH=6
OTP_TTL_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_SENDS_PER_HOUR=5
